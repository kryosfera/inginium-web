---
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHero from '../../components/SectionHero.astro';
import CourseFacts from '../../components/CourseFacts.astro';
import FichaIndice from '../../components/FichaIndice.astro';
import Agenda from '../../components/Agenda.astro';
import TeacherCard from '../../components/TeacherCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Flecha from '../../components/Flecha.astro';
import { puedeInscribirse, etiquetaModalidad } from '../../lib/curso-vista';
import { fechaCorta, fechaIso } from '../../lib/proximo';
export async function getStaticPaths() {
  return (await getCollection('cursos')).map((c) => ({ params: { slug: c.id }, props: { c } }));
}
const { c } = Astro.props as { c: CollectionEntry<'cursos'> };
const d = c.data;
const { Content } = await render(c);
const imgs = import.meta.glob<{ default: ImageMetadata }>('../../assets/cursos/*', { eager: true });
const imagen = d.imagen ? imgs[`../../assets/cursos/${d.imagen}`]?.default : undefined;
const docentes = (await getEntries(d.profesorado.map((id) => ({ collection: 'profesorado' as const, id })))).filter(Boolean) as CollectionEntry<'profesorado'>[];
const patros = (await getEntries(d.patrocinadores.map((id) => ({ collection: 'patrocinadores' as const, id }))))
  .filter((p): p is CollectionEntry<'patrocinadores'> => !!p).map((p) => ({ nombre: p.data.nombre.trim(), logo: p.data.logo }));
const nombresPatro = [...new Set(patros.map((p) => p.nombre).filter(Boolean))];
const agenda = d.agenda?.length ? d.agenda : null;
const descripcion = d.resumen || `Curso de ${d.especialidades.join(', ') || 'formación sanitaria'} en Inginium.`;
const inscribir = puedeInscribirse(d);
const etiqueta = d.modalidad === 'presencial' ? 'Inscribirme' : 'Acceder al curso';
const fecha = fechaCorta(d.fechas, d.anio);
const secciones = [
  d.resumen && { id: 'resumen', label: 'Resumen' },
  d.aprenderas?.length && { id: 'aprenderas', label: 'Qué aprenderás' },
  { id: 'ficha', label: 'Ficha de la actividad' },
  { id: 'programa', label: 'Programa' },
  docentes.length > 0 && { id: 'profesorado', label: 'Profesorado' },
  patros.length > 0 && { id: 'patrocinio', label: 'Patrocinio' },
].filter(Boolean) as { id: string; label: string }[];
const jsonLd = { '@context': 'https://schema.org', '@type': 'Course', name: d.titulo, description: descripcion,
  provider: { '@type': 'Organization', name: 'Inginium', url: 'https://inginium-ksf.com' } };
---
<BaseLayout title={`${d.titulo} · Inginium`} description={descripcion} jsonLd={jsonLd}>
  <SectionHero titulo={d.titulo} imagen={imagen} variante="cartel">
    <div class="h-meta">
      {d.estado === 'finalizado' ? <span class="tag tag-fin">Finalizado</span> : <span class="tag">Activo</span>}
      <span class="mono">{etiquetaModalidad(d.modalidad)}</span>
      {fecha && <time class="mono" datetime={fechaIso(d.fechas) ?? undefined}>{fecha}</time>}
    </div>
    {d.especialidades.length > 0 && <ul class="h-esp" aria-label="Especialidades">{d.especialidades.map((e) => <li>{e}</li>)}</ul>}
    {inscribir && <div class="h-acc"><a class="btn btn-lima" href={d.url!} target="_blank" rel="noopener noreferrer" data-magnetic>{etiqueta} <Flecha tipo="ext" /><span class="sr-only"> (abre en otra pestaña)</span></a></div>}
  </SectionHero>
  <div class="wrap ficha-layout">
    <FichaIndice secciones={secciones} />
    <div class="cuerpo">
      {d.resumen && <section id="resumen" aria-labelledby="resumen-h" class="bloque">
        <h2 id="resumen-h">Resumen</h2>
        <p class="entradilla">{d.resumen}</p>
      </section>}
      {d.aprenderas && d.aprenderas.length > 0 && <section id="aprenderas" aria-labelledby="aprenderas-h" class="bloque">
        <h2 id="aprenderas-h">Qué aprenderás</h2>
        <ol class="aprender">{d.aprenderas.map((a) => <li>{a}</li>)}</ol>
      </section>}
      <CourseFacts curso={c} patrocinadores={nombresPatro} />
      <section id="programa" aria-labelledby="programa-h" class="bloque">
        {agenda
          ? <><h2 id="programa-h">Programa</h2><Agenda agenda={agenda} /></>
          : <><h2 id="programa-h">Descripción y programa</h2><div class="prose"><Content /></div></>}
      </section>
      {docentes.length > 0 && <section id="profesorado" aria-labelledby="prof-h" class="bloque">
        <h2 id="prof-h">Profesorado</h2>
        <div class="teachers">{docentes.map((t) => <TeacherCard docente={t} compacta />)}</div>
      </section>}
      {patros.length > 0 && <section id="patrocinio" aria-labelledby="pat-h" class="bloque">
        <h2 id="pat-h">Actividad patrocinada por</h2>
        <ul class="patros">
          {patros.map((p) => <li>
            {p.logo && <span class="logo"><img src={p.logo} alt="" loading="lazy" width="140" height="48" /></span>}
            <span class:list={['nombre', { 'sr-only': !p.nombre }]}>{p.nombre || 'Patrocinador'}</span>
          </li>)}
        </ul>
      </section>}
    </div>
  </div>
  <ContactCTA />
</BaseLayout>
<style>
  .h-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; font-size: 14px; color: var(--fg); }
  .h-meta .mono { opacity: .9; }
  .h-esp { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .h-esp li { font: 600 13px/1 var(--f-body); padding: 7px 11px; border-radius: 999px; border: 1px solid var(--line); }
  .h-acc { margin-top: 6px; }

  .ficha-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 64px; padding-block: 0 96px; }
  .cuerpo { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(56px, 6vw, 80px); padding-top: 40px; min-width: 0; }
  .bloque { display: grid; gap: 20px; align-content: start; }
  h2 { font-size: clamp(26px, 2.8vw, 36px); }
  .entradilla { font-size: clamp(19px, 1.6vw, 22px); line-height: 1.55; max-width: 60ch; text-wrap: pretty; }
  .aprender { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; counter-reset: ap; }
  .aprender li { counter-increment: ap; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 16px; align-items: start; padding-block: 14px; border-top: 1px solid var(--line); max-width: 68ch; }
  .aprender li::before { content: counter(ap, decimal-leading-zero); display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--lima); color: var(--tinta); font: 500 14px/1 var(--f-mono); }
  .aprender li { line-height: 1.5; padding-top: 16px; }

  .prose { overflow-wrap: anywhere; max-width: 72ch; font-size: 17px; }
  .prose :global(p) { margin-block: 0 .9em; }
  .prose :global(:is(h2, h3, h4, h5, h6)) { font-family: var(--f-display); font-size: 18px; line-height: 1.3; letter-spacing: -.01em; margin: 1.6em 0 .6em; }
  .prose :global(:is(h2, h3, h4, h5, h6):empty), .prose :global(p:empty) { display: none; }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(em) { color: var(--muted); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; margin-block: 0 1em; }
  .prose :global(li::marker) { color: var(--accent-text); }
  .prose :global(a) { color: var(--accent-text); text-underline-offset: 3px; }
  .prose :global(table) { display: block; overflow-x: auto; max-width: 100%; border-collapse: collapse; font-size: 15px; }
  .prose :global(td), .prose :global(th) { padding: 8px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .prose :global(figure) { margin: 0 0 1em; }
  .prose :global(img) { max-width: 100%; height: auto; border-radius: 12px; }

  .teachers { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .patros { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
  .patros li { display: grid; gap: 12px; align-content: start; padding: 18px; border: 1px solid var(--line); border-radius: 16px; background: var(--card); }
  .patros .logo { display: flex; align-items: center; height: 48px; }
  .patros img { max-height: 48px; width: auto; max-width: 160px; object-fit: contain; }
  .patros .nombre { font-weight: 600; font-size: 15px; }

  @media (min-width: 1024px) {
    .ficha-layout { grid-template-columns: 200px minmax(0, 1fr); }
    .cuerpo { padding-top: 64px; max-width: 820px; }
    :global(.indice) { margin-top: 64px; }
  }
</style>
