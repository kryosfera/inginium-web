---
// Flecha dibujada (no un glifo): «der» → y «ext» ↗ (enlace externo).
interface Props { tipo?: 'der' | 'ext'; size?: number; class?: string }
const { tipo = 'der', size = 16, class: cls } = Astro.props;
---
<svg class:list={['flecha', { 'flecha-der': tipo === 'der' }, cls]} viewBox="0 0 16 16" width={size} height={size} aria-hidden="true" focusable="false">
  {tipo === 'der'
    ? <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    : <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />}
</svg>
