---
interface Props { titulo?: string }
const { titulo = '¿Quieres patrocinar un curso o formar parte del próximo?' } = Astro.props;
---
<section class="cta-final" data-mode="oscuro" aria-labelledby="cta-h">
  <div class="wrap inner">
    <span class="eyebrow">Hablemos</span>
    <h2 id="cta-h" data-split>{titulo}</h2>
    <div class="row">
      <a class="btn btn-lima" href="/contacto" data-magnetic>Contactar</a>
      <a class="btn btn-secondary" href="/cursos">Ver cursos</a>
    </div>
  </div>
</section>
<style>
  .cta-final { padding-block: 110px; border-top: 1px solid var(--line); }
  .inner { display: grid; gap: 18px; }
  h2 { font-size: clamp(34px, 4.6vw, 68px); max-width: 18ch; }
  .row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
</style>
