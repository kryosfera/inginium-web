---
import sala from '../assets/hero/sala-curso.jpg';
import grabacion from '../assets/hero/grabacion.jpg';
import rodaje from '../assets/hero/rodaje.jpg';
import organizacion from '../assets/hero/organizacion.jpg';
import { fuentesCabecera, SIZES_CABECERA as SIZES } from '../lib/imagen-cabecera';

// Cabecera de la home: cuatro fotos que rotan con fundido. Solo la primera se descarga al cargar;
// las demás llevan data-src/data-srcset y las promueve home-hero.ts justo antes de mostrarlas.
const fotos = [sala, grabacion, rodaje, organizacion];
const capas = await Promise.all(fotos.map(fuentesCabecera));
const miArea = import.meta.env.PUBLIC_MI_AREA_URL;
---
<section class="hhero" data-mode="oscuro" data-home-hero>
  <div class="bg">
    {capas.map((c, i) => (
      <picture class:list={['layer', { 'is-on': i === 0 }]} data-hero-layer>
        {i === 0 ? <>
          <source type="image/avif" srcset={c.avif} sizes={SIZES} />
          <source type="image/webp" srcset={c.webp} sizes={SIZES} />
          <img src={c.src} width={c.w} height={c.h} alt="" loading="eager" fetchpriority="high" decoding="async" />
        </> : <>
          <source type="image/avif" data-srcset={c.avif} sizes={SIZES} />
          <source type="image/webp" data-srcset={c.webp} sizes={SIZES} />
          <img data-src={c.src} width={c.w} height={c.h} alt="" decoding="async" />
        </>}
      </picture>
    ))}
  </div>
  <div class="shade" aria-hidden="true"></div>
  <div class="wrap inner">
    <span class="eyebrow">Inginium · Improving your future</span>
    <h1 data-split>Formación continuada para profesionales sanitarios</h1>
    <p class="lead">Portal de formación diseñado específicamente para facilitar la formación continuada fomentando que la práctica clínica sea segura y de calidad.</p>
    <div class="row">
      <a class="btn btn-lima" href="/cursos#activos" data-magnetic>Cursos activos</a>
      {miArea && <a class="btn btn-secondary" href={miArea}>Mi área</a>}
    </div>
  </div>
  <button class="pause" type="button" hidden data-hero-pause aria-pressed="false"><span aria-hidden="true" data-hero-glyph>❚❚</span> Pausar fotos</button>
</section>
<script>import '../scripts/home-hero';</script>
<style>
  .hhero { background: var(--bg); color: var(--fg); position: relative; overflow: hidden; isolation: isolate; min-height: min(92vh, 860px); display: grid; align-items: end; padding-block: clamp(120px, 18vh, 200px) clamp(56px, 8vh, 96px); }
  .bg { position: absolute; inset: 0; z-index: -2; }
  .layer { position: absolute; inset: 0; display: block; opacity: 0; visibility: hidden; }
  .layer.is-on { opacity: 1; visibility: visible; }
  .layer :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, color-mix(in srgb, var(--bg) 82%, transparent) 0%, color-mix(in srgb, var(--bg) 80%, transparent) 40%, color-mix(in srgb, var(--bg) 35%, transparent) 100%), linear-gradient(180deg, color-mix(in srgb, var(--bg) 30%, transparent), var(--bg) 96%); }
  .inner { display: grid; gap: 16px; }
  h1 { font-size: clamp(44px, 6.4vw, 96px); font-weight: 900; max-width: 14ch; }
  .lead { font-size: clamp(18px, 1.5vw, 21px); max-width: 52ch; opacity: .9; }
  .row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 10px; }
  .pause[hidden] { display: none; }
  .pause { position: absolute; right: var(--gutter); bottom: 20px; border: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 70%, transparent); color: var(--muted); border-radius: 999px; padding: 6px 11px; font: 600 12px/1 var(--f-body); cursor: pointer; }
  .pause:hover, .pause:focus-visible { color: var(--fg); }
  .pause[aria-pressed="true"] { border-color: currentColor; }
  @media (prefers-reduced-motion: reduce) { .pause { display: none; } }
</style>
