---
interface Props { title: string; description: string; jsonLd?: object; noindex?: boolean; image?: string }
const { title, description, jsonLd, noindex = false, image = '/og.png' } = Astro.props;
// Con build.format 'file' el pathname acaba en .html: se normaliza a la URL pública del sitemap.
const ruta = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/+$/, '') || '/';
const canonical = new URL(ruta, Astro.site);
const imagen = new URL(image, Astro.site);
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Inginium',
  legalName: 'Kryosfera Solutions, S.L.', url: 'https://inginium-ksf.com', email: 'info@ksf.es', logo: new URL('/og.png', Astro.site).href,
  parentOrganization: { '@type': 'Organization', name: 'KSF Digital Healthcare', url: 'https://ksf.es' },
  address: { '@type': 'PostalAddress', streetAddress: 'Nicaragua 106', postalCode: '08029', addressLocality: 'Barcelona', addressCountry: 'ES' } };
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="Inginium · Formación sanitaria" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagen} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={imagen} />
<script type="application/ld+json" set:html={JSON.stringify(org)} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
