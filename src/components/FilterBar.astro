---
import { slugEspecialidad } from '../lib/cursos';
interface Props { especialidades: string[]; anios: number[]; recuento?: Record<string, number> }
const { especialidades, anios, recuento = {} } = Astro.props;
---
<form class="filtros" role="search" action="/cursos" method="get" aria-label="Filtrar cursos">
  <div class="fila">
    <label class="campo">
      <span>Buscar curso</span>
      <input type="search" name="q" maxlength="80" autocomplete="off" placeholder="Título o tema" />
    </label>
    <label class="campo campo-anio">
      <span>Año</span>
      <select name="anio">
        <option value="">Todos los años</option>
        {anios.map((a) => <option value={a}>{a}</option>)}
      </select>
    </label>
    <div class="vista" role="group" aria-label="Vista" hidden data-vista-grupo>
      <span class="vista-et" aria-hidden="true">Vista</span>
      <div class="seg">
        <button type="button" data-vista="rejilla" aria-pressed="true">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 2h5v5H2zM9 2h5v5H9zM2 9h5v5H2zM9 9h5v5H9z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          Rejilla
        </button>
        <button type="button" data-vista="anios" aria-pressed="false">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 3h12M2 8h12M2 13h12M5 1.5v3M5 6.5v3M5 11.5v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          Por años
        </button>
      </div>
    </div>
  </div>
  {especialidades.length > 0 && (
    <div class="chips" role="group" aria-label="Especialidad" hidden>
      {especialidades.map((e) => (
        <button type="button" class="chip" data-esp={slugEspecialidad(e)} aria-pressed="false">
          {e}{recuento[e] != null && <span class="n mono"><span class="sr-only">, </span>{recuento[e]}<span class="sr-only"> {recuento[e] === 1 ? 'curso' : 'cursos'}</span></span>}
        </button>
      ))}
    </div>
  )}
  <p class="resultado" role="status" aria-live="polite"></p>
</form>
<style>
  .filtros { display: grid; gap: 16px; padding-block: 32px 8px; }
  .fila { display: flex; flex-wrap: wrap; align-items: end; gap: 16px; }
  .campo { display: grid; gap: 6px; flex: 1 1 280px; }
  .campo-anio { flex: 0 1 200px; }
  .campo span, .vista-et { font: 500 12px/1.2 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  input, select { font: 500 16px/1.2 var(--f-body); color: var(--fg); background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; min-height: 48px; transition: border-color .2s; }
  input:hover, select:hover { border-color: var(--fg); }
  input::placeholder { color: var(--muted); }
  .vista[hidden], .chips[hidden] { display: none; }
  .vista { display: grid; gap: 6px; }
  .seg { display: inline-flex; padding: 3px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); }
  .seg button { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; font: 600 14px/1 var(--f-body); color: var(--muted); background: transparent; border: 0; border-radius: 9px; cursor: pointer; transition: background-color .2s, color .2s; }
  .seg button:hover { color: var(--fg); }
  .seg button[aria-pressed="true"] { background: var(--tinta); color: #F5F7FA; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; font: 600 14px/1 var(--f-body); color: var(--fg); background: transparent; border: 1.5px solid var(--line); border-radius: 999px; padding: 10px 12px 10px 16px; min-height: 44px; cursor: pointer; transition: border-color .2s, background-color .2s; }
  .chip:hover { border-color: var(--fg); }
  .chip .n { font-size: 12px; font-weight: 500; min-width: 1.9em; padding: 4px 6px; border-radius: 999px; text-align: center; background: color-mix(in srgb, var(--fg) 7%, transparent); }
  .chip[aria-pressed="true"] { background: var(--lima); border-color: var(--lima); color: var(--tinta); }
  .chip[aria-pressed="true"] .n { background: rgba(11, 11, 44, .12); }
  .chip:focus-visible, .seg button:focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; }
  .resultado { margin: 0; min-height: 1.6em; font: 500 14px/1.6 var(--f-mono); color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .chip, .seg button, input, select { transition: none; } }
</style>
