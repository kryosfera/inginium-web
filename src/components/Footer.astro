---
import logo from '../assets/inginium-logo.svg?raw';
const year = new Date().getFullYear();
---
<footer data-mode="oscuro" class="site-footer">
  <div class="wrap grid">
    <div class="brandcol">
      <div class="logo"><Fragment set:html={logo} /></div>
      <p class="claim">Improving your future</p>
      <p class="addr">Formación continuada acreditada para profesionales sanitarios, patrocinada por la industria de la salud.</p>
    </div>
    <nav aria-label="Cursos"><p class="eyebrow">Cursos</p>
      <ul><li><a href="/cursos">Cursos activos</a></li><li><a href="/cursos#archivo">Archivo</a></li><li><a href="/profesorado">Profesorado</a></li></ul></nav>
    <nav aria-label="Inginium"><p class="eyebrow">Inginium</p>
      <ul><li><a href="/acerca">Acerca de</a></li><li><a href="/contacto">Contacto</a></li></ul></nav>
    <nav aria-label="Legal"><p class="eyebrow">Legal</p>
      <ul><li><a href="/legal/aviso-legal">Aviso legal</a></li><li><a href="/legal/privacidad">Privacidad</a></li></ul></nav>
  </div>
  <p class="wrap firma">Un proyecto de <span class="grad-text">KSF Digital Healthcare</span> · con ESADE Business School</p>
  <p class="wrap copy">© {year} Kryosfera Solutions, S.L.</p>
</footer>
<style>
  .site-footer { padding-block: 64px 28px; border-top: 1px solid var(--line); }
  .grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 32px; }
  .logo { display: inline-block; color: var(--fg); }
  .logo :global(svg) { height: 40px; width: auto; display: block; }
  .claim { font: 900 22px/1.1 var(--f-display); margin-top: 18px; }
  .addr { color: var(--muted); font-size: 15px; margin-top: 10px; max-width: 38ch; }
  ul { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 8px; }
  nav a { text-decoration: none; color: var(--fg); opacity: .85; } nav a:hover { opacity: 1; }
  .firma { font: 500 14px/1.4 var(--f-body); margin-top: 48px; }
  .copy { color: var(--muted); font-size: 13px; margin-top: 8px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr 1fr; } .brandcol { grid-column: 1 / -1; } }
</style>
