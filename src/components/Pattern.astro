---
interface Props { label?: string }
const { label } = Astro.props;
---
<div class="pattern" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <svg viewBox="0 0 40 40" width="56" height="56"><path d="M6 10a4 4 0 0 1 4-4h20a4 4 0 0 1 4 4v16l-8 8H10a4 4 0 0 1-4-4z" fill="#b5dc10"/></svg>
</div>
<style>
  .pattern { width: 100%; height: 100%; display: grid; place-items: center; background:
    radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--fg) 14%, transparent) 1px, transparent 0) 0 0 / 18px 18px, var(--card); }
</style>
