---
// Índice de la ficha: lateral fijo (sticky) en escritorio, tira horizontal desplazable en móvil.
// scripts/indice.ts marca la sección activa (aria-current) con IntersectionObserver.
interface Props { secciones: { id: string; label: string }[] }
const { secciones } = Astro.props;
---
<nav class="indice" aria-label="En esta ficha" data-indice>
  <p class="ind-t" aria-hidden="true">En esta ficha</p>
  <ol>
    {secciones.map((s) => <li><a href={`#${s.id}`} data-indice-link={s.id}>{s.label}</a></li>)}
  </ol>
</nav>
<script>import '../scripts/indice';</script>
<style>
  .indice { min-width: 0; }
  .ind-t { font: 500 11px/1 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  ol { list-style: none; margin: 0; padding: 0; }
  a { display: block; text-decoration: none; color: var(--muted); font: 600 15px/1.3 var(--f-body); transition: color .2s, border-color .2s, background-color .2s; }
  a:hover { color: var(--fg); }
  a[aria-current="true"] { color: var(--fg); }
  @media (min-width: 1024px) {
    .indice { position: sticky; top: 104px; align-self: start; }
    ol { display: grid; border-left: 2px solid var(--line); }
    a { padding: 9px 0 9px 16px; margin-left: -2px; border-left: 2px solid transparent; }
    a[aria-current="true"] { border-left-color: var(--accent-text); }
  }
  @media (max-width: 1023px) {
    .indice { position: sticky; top: 60px; z-index: 30; margin-inline: calc(-1 * var(--gutter)); background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
    .ind-t { display: none; }
    ol { display: flex; gap: 6px; overflow-x: auto; padding: 10px var(--gutter); scrollbar-width: none; scroll-snap-type: x proximity; }
    ol::-webkit-scrollbar { display: none; }
    li { flex: none; scroll-snap-align: start; }
    a { padding: 10px 14px; border-radius: 999px; border: 1.5px solid var(--line); white-space: nowrap; font-size: 14px; min-height: 40px; }
    a[aria-current="true"] { background: var(--tinta); border-color: var(--tinta); color: #F5F7FA; }
  }
  @media (prefers-reduced-motion: reduce) { a { transition: none; } }
</style>
